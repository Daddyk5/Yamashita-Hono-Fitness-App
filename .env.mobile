# Used only for the Capacitor/Android build (`pnpm build:mobile`).
# 10.0.2.2 is the Android emulator's special alias for "the host machine's
# localhost" -- plain "localhost" inside the emulator means the emulator
# itself, not your PC. On a physical device over Wi-Fi, replace this with
# your PC's LAN IP instead (e.g. http://192.168.1.23:4000).
VITE_API_URL=http://10.0.2.2:4000
