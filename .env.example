# Copy to .env and adjust as needed. Used by docker-compose.yml.
DB_USER=fitness_app
DB_PASSWORD=fitness_app_password
DB_NAME=fitness_app
DB_PORT=5432
CORS_ORIGIN=http://localhost:8443,http://localhost,https://localhost,capacitor://localhost

# Read by the frontend (Vite) so it knows where the backend API is.
VITE_API_URL=http://localhost:4000

# Get a key at https://console.anthropic.com/settings/keys
# Leave blank to automatically fall back to the local Ollama model below.
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-haiku-4-5

# Local fallback (no API key needed). Requires Ollama running on the host
# with the model pulled: `ollama pull llama3.2:3b`. docker-compose reaches
# your host's Ollama server via host.docker.internal automatically.
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b
