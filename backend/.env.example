# Copy to backend/.env for running the backend outside Docker (pnpm/npm run dev).
# When running via `docker compose up`, the root .env / docker-compose.yml
# environment block is used instead and DB_HOST becomes "postgres".
PORT=4000
NODE_ENV=development
DB_HOST=localhost
DB_PORT=5432
DB_USER=fitness_app
DB_PASSWORD=fitness_app_password
DB_NAME=fitness_app
CORS_ORIGIN=http://localhost:8443

# Get a key at https://console.anthropic.com/settings/keys
# Leave blank to automatically fall back to the local Ollama model below.
ANTHROPIC_API_KEY=
# Fast/cheap model used for the workout chat assistant.
CHAT_MODEL=claude-haiku-4-5

# Local fallback (no API key needed). Requires Ollama running on the host
# with the model pulled: `ollama pull llama3.2:3b`.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Auth. Change all three before deploying anywhere real.
JWT_SECRET=dev-only-secret-change-me
ADMIN_EMAIL=admin@ironvein.io
ADMIN_PASSWORD=changeme
